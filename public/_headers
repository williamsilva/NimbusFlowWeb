/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://flow-api.nimbussystems.com.br https://cloudflareinsights.com https://viacep.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# O service worker e o manifest de arquivos dele NUNCA podem ser "immutable" - o navegador
# precisa buscar ngsw.json/ngsw-worker.js de novo a cada verificação de atualização (senão o PWA
# nunca detecta um deploy novo). Regras mais específicas depois das gerais acima, sobrescrevendo
# Cache-Control só pra esses arquivos - mesmo gotcha do cache immutable do Cloudflare já visto
# nesta sessão, dessa vez pego antes do deploy em vez de depois.
/ngsw.json
  Cache-Control: no-cache, no-store, must-revalidate

/ngsw-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
